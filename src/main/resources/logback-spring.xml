<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

    <property name="LOG_DIR" value="logs"/>

    <!-- Console -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="com.exittrading.app.logging.MarketHoursFilter" />
        <encoder>
            <!-- Include stack traces when present -->
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- General info/warn rolling file (exclude ERROR) -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app-info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-info-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <filter class="com.exittrading.app.logging.MarketHoursFilter" />
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <encoder>
            <!-- Capture stack traces for WARN-level exceptions as well -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Errors only rolling file -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-error-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <!-- Always include full stack traces for errors -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Ticker per-holding readable stream -->
    <appender name="TICKER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/ticker.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/ticker-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>5</maxHistory>
        </rollingPolicy>
        <filter class="com.exittrading.app.logging.MarketHoursFilter" />
        <encoder>
            <pattern>%d{HH:mm:ss} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Liquidity impact API rolling file (daily, keep last 5 trading days) -->
    <appender name="IMPACT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/impact.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Roll daily; retain last 5 days -->
            <fileNamePattern>${LOG_DIR}/impact-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>5</maxHistory>
        </rollingPolicy>
        <!-- Allow only during Mon–Fri, 09:15–16:00 IST -->
        <filter class="com.exittrading.app.logging.MarketHoursFilter" />
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logging Scrips rolling file (Mon-Fri, 09:15-15:30 IST) -->
    <appender name="SCRIP_LOG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/scrips.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/scrips-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>10</maxHistory>
        </rollingPolicy>
        <filter class="com.exittrading.app.logging.LoggingWindowFilter" />
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Route ticker logger (holdings depth stream) to scrips log as well -->
    <logger name="ticker" level="INFO" additivity="false">
        <appender-ref ref="SCRIP_LOG_FILE"/>
    </logger>

    <!-- Route ImpactLog logger to IMPACT_FILE only -->
    <logger name="ImpactLog" level="INFO" additivity="false">
        <appender-ref ref="IMPACT_FILE"/>
    </logger>

    <!-- Route logging scrips to dedicated rolling file -->
    <logger name="scrip-log" level="INFO" additivity="false">
        <appender-ref ref="SCRIP_LOG_FILE"/>
    </logger>
    <!-- Always-on rolling file (No market hours filter) -->
    <appender name="ALWAYS_ON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app-system.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-system-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Route Session/Instrument loggers to ALWAYS_ON_FILE (Relaxed) -->
    <logger name="com.exittrading.app.service.core.SessionPersistence" level="INFO" additivity="true">
        <appender-ref ref="ALWAYS_ON_FILE"/>
    </logger>
    <logger name="com.exittrading.app.service.core.KiteSessionManager" level="INFO" additivity="true">
        <appender-ref ref="ALWAYS_ON_FILE"/>
    </logger>
    <logger name="com.exittrading.app.controller.SessionController" level="INFO" additivity="true">
        <appender-ref ref="ALWAYS_ON_FILE"/>
    </logger>
    <logger name="com.exittrading.app.service.core.InstrumentService" level="INFO" additivity="true">
        <appender-ref ref="ALWAYS_ON_FILE"/>
    </logger>
    <logger name="com.exittrading.app" level="INFO" additivity="true">
        <appender-ref ref="ALWAYS_ON_FILE"/>
    </logger>
    <!-- LoggingScripService is for data logging, but its system messages (sync etc) might be wanted.
         However, it's currently routed to SCRIP_LOG_FILE which is filtered.
         Given the user asked for "instruments", I will also route InstrumentRepository if needed,
         but LoggingScripService is the main manager. Using ALWAYS_ON implies system ops.
         I will route LoggingScripService to ALWAYS_ON_FILE as well, removing it from SCRIP_LOG_FILE exclusivity?
         No, SCRIP_LOG_FILE is for "Scrip Log".
         I'll leave LoggingScripService as is (filtered) unless explicitly asked, as it logs data row-by-row.
         Wait, "instruments" likely refers to InstrumentService (metadata).
    -->

    <!-- Keep LoggingScripService chatter out of app-info; route to scrips log -->
    <logger name="com.exittrading.app.service.scrip.LoggingScripService" level="INFO" additivity="false">
        <appender-ref ref="SCRIP_LOG_FILE"/>
    </logger>

    <!-- Route raw-ticks logger (Removed per Architect recommendation: Single Path DB is sufficient) -->
    <!-- <logger name="raw-ticks" level="INFO" additivity="false">
        <appender-ref ref="RAW_TICKS"/>
    </logger> -->

    <!-- Root: console + general + errors -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="INFO_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
